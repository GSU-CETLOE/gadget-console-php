{
  "name": "gsu-cetloe/gadget-console-php",
  "description": "Gadget library for Symfony console apps: a logging-aware command base, a shell command runner, and a listener that logs command start, finish, and errors, with a Symfony bundle",
  "type": "library",
  "keywords": [],
  "homepage": "https://github.com/GSU-CETLOE/gadget-console-php",
  "license": "MIT",
  "authors": [
    {
      "name": "Jeb Barger",
      "role": "Application Developer"
    }
  ],
  "require": {
    "php": "8.1.*",
    "gsu-cetloe/gadget-core-php": "^1.0",
    "gsu-cetloe/gadget-log-php": "^1.0",
    "gsu-cetloe/gadget-process-php": "^1.0",
    "gsu-cetloe/symfony-bundle": "^1.0",
    "symfony/console": "6.4.*",
    "symfony/event-dispatcher": "6.4.*"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.0",
    "phpstan/phpstan-strict-rules": "^2.0",
    "phpstan/extension-installer": "^1.4",
    "phpunit/phpunit": "^10.5",
    "squizlabs/php_codesniffer": "^3.10"
  },
  "autoload": {
    "psr-4": {
      "Gadget\\Console\\": ["src/", "bundle/"]
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Gadget\\Console\\Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "phpstan/extension-installer": true
    },
    "platform": {
      "php": "8.1.0"
    },
    "sort-packages": true,
    "optimize-autoloader": true,
    "apcu-autoloader": true
  },
  "scripts": {
    "phpcs": "vendor/bin/phpcs",
    "phpstan": "vendor/bin/phpstan analyse -c phpstan.neon",
    "test": "vendor/bin/phpunit",
    "check": [
      "@phpcs",
      "@phpstan",
      "@test"
    ]
  }
}
